# Copy to .env.local for local dev. In production, set these in Vercel → Settings → Environment Variables.
# Never commit real values.

# Neon Postgres (Neon console → Connect → pooled connection string)
DATABASE_URL=

# Vaani AI webhooks are unsigned: this secret goes in the webhook URL as ?token=
VAANI_WEBHOOK_SECRET=
VAANI_RATE_INR_PER_MIN=5

# Gemini (aistudio.google.com → Get API key). Pick a Flash model open on the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_INR_PER_M_INPUT=0
GEMINI_INR_PER_M_OUTPUT=0

# Resend. The sandbox sender onboarding@resend.dev only delivers to your Resend signup email.
RESEND_API_KEY=
EMAIL_FROM=Aangan Leads <onboarding@resend.dev>
FRONT_DESK_EMAIL=

# Signs the Claim / Reschedule links in designer emails
LINK_SECRET=

# Dashboard basic auth: username "aangan"
DASHBOARD_PASSWORD=

# Optional
HUBSPOT_PRIVATE_APP_TOKEN=
CALCOM_BOOKING_URL=
# Defaults to https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel
APP_URL=
